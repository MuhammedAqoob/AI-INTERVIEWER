# Client Environment Variables

# Backend API URL
# For local development: leave unset (defaults to /api, proxied to localhost:5000)
# For production (Vercel): set to your Render backend URL
# Example: NEXT_PUBLIC_API_URL=https://your-app.onrender.com/api
NEXT_PUBLIC_API_URL=

# Backend URL for Next.js rewrites (build-time only, local dev only)
# Only needed if running `next build` locally with a non-default backend
BACKEND_URL=http://localhost:5000

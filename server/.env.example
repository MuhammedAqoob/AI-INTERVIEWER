# Server Environment Variables

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_interviewer?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development
# Per-user interview starts per minute (default: 20 in development, 3 in production)
INTERVIEW_START_RATE_LIMIT=20

# Redis (optional cache layer – leaderboard only. App works without it.)
REDIS_URL="redis://127.0.0.1:6379"

# Z.AI provider
ZAI_API_KEY=""
ZAI_MODEL="glm-4.7-flash"

# Cohere provider
COHERE_API_KEY=""
COHERE_MODEL="command-a-plus-05-2026"

# AI provider protection (all limits are process-local in this phase)
AI_REQUEST_TIMEOUT=12000
AI_OPERATION_TIMEOUT_MS=30000
AI_RETRY_COUNT=0
AI_ZAI_CONCURRENCY=4
AI_GROQ_CONCURRENCY=4
AI_COHERE_CONCURRENCY=4
AI_CIRCUIT_COOLDOWN_MS=15000

# A crashed request's answer claim may be safely replaced after this period.
ANSWER_CLAIM_TTL_MS=90000

# Client URL (for CORS)
CLIENT_URL="http://localhost:3000"

# Interview limits (defaults used if omitted)
MAX_SESSIONS_PER_USER=10
MAX_TURNS_PER_SESSION=10

# Leaderboard (only sessions with at least this many evaluated answers count)
LEADERBOARD_MIN_SAMPLES=5
